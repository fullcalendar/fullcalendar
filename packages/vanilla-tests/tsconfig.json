{
  "extends": "@fullcalendar-scripts/standard/config/tsconfig.browser.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "types": [
      "@vitest/browser-playwright"
    ]
  },
  "include": [
    "./src/**/*",
    "./*.ts"
  ],
  // The *.unit.ts specs import library source. These resolve it to the built declarations
  "references": [
    {
      "path": "../headless-calendar"
    },
    {
      "path": "../preact"
    }
  ]
}
